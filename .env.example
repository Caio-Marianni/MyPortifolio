# Neon — connection string do painel (a "pooled" serve; o driver HTTP não usa pool próprio)
DATABASE_URL=postgresql://user:senha@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Assina os links de avaliação e a sessão do painel. Qualquer string longa e aleatória:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor invalida todos os links já enviados e derruba a sessão do painel.
REVIEW_SECRET=

# Senha do painel em /admin. O campo "usuário" da tela é isca e precisa ficar vazio; errar
# 5 vezes tranca aquele IP por 15 minutos. Ainda assim, quanto mais longa, melhor.
ADMIN_PASSWORD=

# Só pro script de convite, quando quiser gerar link apontando pra outro host (padrão: produção)
# SITE_URL=http://localhost:3000

# Relatório mensal: conta de serviço do Google Cloud com a "Google Analytics Data API" ativada.
# Do JSON da chave, copie `client_email` e `private_key` (a chave numa linha só, com os \n).
# Em cada cliente, adicione o e-mail da conta como "Leitor" na propriedade do GA4 dele.
# GA_CLIENT_EMAIL=relatorios@seu-projeto.iam.gserviceaccount.com
# GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
